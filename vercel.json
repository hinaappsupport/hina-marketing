{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/server.js"
    },
    {
      "src": "/privacy-policy",
      "dest": "/server.js"
    },
    {
      "src": "/terms",
      "dest": "/server.js"
    },
    {
      "src": "/vision",
      "dest": "/server.js"
    },
    {
      "src": "/team",
      "dest": "/server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}